# Copy this file to .env.local and fill in what you need.
# Vite only exposes variables that start with VITE_.

# Where the Flask backend is running.
VITE_API_URL=http://127.0.0.1:5000

# Optional. When set, the header shows a "Call us" / "WhatsApp" link.
# Use the international format, for example +2547XXXXXXXX.
VITE_CONTACT_PHONE=
VITE_WHATSAPP_NUMBER=
